{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://witdiff.dev/schemas/witdiff.receipt.v1.schema.json",
  "title": "WitDiff Receipt v1",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "repo_root",
    "base",
    "head_commit",
    "workspace_fingerprint_before",
    "workspace_fingerprint_after",
    "evidence_fresh",
    "changed_files",
    "changed_test_files",
    "integrity_findings",
    "head_run",
    "red_green_proven",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "witdiff.receipt.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "verified_with_warnings",
        "not_verified",
        "no_changed_tests",
        "head_failed",
        "base_incompatible"
      ]
    },
    "repo_root": {
      "type": "string"
    },
    "base": {
      "type": "string"
    },
    "head_commit": {
      "type": "string"
    },
    "workspace_fingerprint_before": {
      "type": "string"
    },
    "workspace_fingerprint_after": {
      "type": "string"
    },
    "evidence_fresh": {
      "type": "boolean"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changed_file"
      }
    },
    "changed_test_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrity_findings": {
      "type": "array"
    },
    "head_run": {
      "$ref": "#/$defs/run"
    },
    "base_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/run"
        },
        {
          "type": "null"
        }
      ]
    },
    "red_green_proven": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_control_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/run"
        },
        {
          "type": "null"
        }
      ]
    },
    "test_selection": {
      "$ref": "#/$defs/test_selection",
      "description": "Which test command variant produced head_run and base_run. Defaults to full_suite, which is what receipts written before this field existed recorded."
    },
    "effective_test_command": {
      "description": "The exact argument vector used for the proof runs, after any narrowing. Recorded so a consumer never has to infer what was executed.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "spliced_inline_tests": {
      "description": "Inline #[cfg(test)] test modules transplanted by span splicing. Each entry names the file and the module paths that were moved. The file exists in neither revision: its production code is the base revision's and its test module is the head revision's. See ADR-0010.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/spliced_inline_tests"
      }
    },
    "refused_inline_tests": {
      "description": "Files that carry inline test changes which could not be transplanted, with the precondition that failed. Recorded so a reader can distinguish 'WitDiff declined to splice this' from 'WitDiff did not consider it'.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/refused_inline_tests"
      }
    },
    "mutation": {
      "description": "Changed-code mutation evidence. Supplementary only: it never affects `status`, because a surviving mutant is a question about test strength rather than a verdict about correctness (ADR-0011). Omitted when mutation is disabled.",
      "oneOf": [
        {
          "$ref": "#/$defs/mutation_report"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "test_selection": {
      "type": "string",
      "enum": [
        "full_suite",
        "targeted"
      ]
    },
    "changed_file": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "is_test",
        "tracked"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "previous_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "is_test": {
          "type": "boolean"
        },
        "tracked": {
          "type": "boolean"
        },
        "path_is_lossy": {
          "type": "boolean",
          "description": "True when the path could not be decoded as UTF-8 and was lossily replaced. Such a path is not transplanted, because the lossy text names a file that does not exist."
        },
        "previous_is_test": {
          "type": "boolean",
          "description": "For a rename or copy, whether the source path was itself a test. False means the source was production code and the file must not be transplanted as part of a test-only patch."
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "command",
        "cwd",
        "success",
        "duration_ms",
        "stdout",
        "stderr"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "failure_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "test_failure",
            "compile_error",
            "command_failure",
            "spawn_failure",
            "timeout",
            "unknown",
            null
          ]
        },
        "timed_out": {
          "type": "boolean",
          "description": "True when the run was killed for exceeding verification.timeout_secs. A timed-out run is never a proof."
        }
      }
    },
    "spliced_inline_tests": {
      "type": "object",
      "required": [
        "path",
        "modules"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Repository-relative path of the spliced file."
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Module paths transplanted, e.g. 'tests'."
        }
      }
    },
    "refused_inline_tests": {
      "type": "object",
      "required": [
        "path",
        "reason",
        "explanation"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "unparsable",
            "no_test_module_in_head",
            "no_counterpart_in_base",
            "test_outside_test_module",
            "change_outside_test_module"
          ]
        },
        "explanation": {
          "type": "string",
          "description": "Operator-facing explanation of the failed precondition."
        }
      }
    },
    "mutation_report": {
      "type": "object",
      "required": [
        "generated",
        "killed",
        "survived",
        "not_compiled",
        "timeout",
        "skipped"
      ],
      "additionalProperties": false,
      "properties": {
        "generated": {
          "type": "integer",
          "minimum": 0,
          "description": "Mutants generated for the changed production code, before the run bound was applied."
        },
        "killed": {
          "type": "integer",
          "minimum": 0
        },
        "survived": {
          "type": "integer",
          "minimum": 0,
          "description": "Mutants the tests did not detect. Each is a question about test strength, not a verdict."
        },
        "not_compiled": {
          "type": "integer",
          "minimum": 0,
          "description": "Mutants that failed to build and were therefore never executed. Never counted as kills."
        },
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Mutants not attempted because a bound was reached."
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutant_result"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mutant_result": {
      "type": "object",
      "required": [
        "id",
        "path",
        "operator",
        "line",
        "original",
        "replacement",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Deterministic identifier derived from path, span and operator."
        },
        "path": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "equality_flip",
            "comparison_boundary",
            "logical_flip",
            "boolean_flip"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "function": {
          "type": [
            "string",
            "null"
          ]
        },
        "original": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "killed",
            "survived",
            "not_compiled",
            "timeout",
            "skipped"
          ]
        },
        "cached": {
          "type": "boolean"
        }
      }
    }
  }
}
